# CHEESE Bridge Contracts - Environment Variables
# Copy this file to .env and fill in your values

# Your wallet private key (the one that will deploy and own the contract)
# IMPORTANT: Never share this! Do NOT commit .env to git!
PRIVATE_KEY=

# BSCScan API key for contract verification
# Get one at: https://bscscan.com/myapikey
BSCSCAN_API_KEY=
