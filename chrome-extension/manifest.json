{
  "manifest_version": 3,
  "name": "Cheese Wallet",
  "version": "1.0.0",
  "description": "Premium EVM-compatible browser wallet for the Cheese Blockchain. Instantly connect to DEX and DApps.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
